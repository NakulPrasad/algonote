{
  "name": "algonote",
  "displayName": "AlgoNote AI",
  "description": "Smart Note-First study companion: active recall quizzes, AI note fill, structural linting, and spaced repetition tracking.",
  "version": "0.1.7",
  "publisher": "nakul",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "AI",
    "Chat"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onView:algonote-quiz",
    "onView:algonote-revision"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "algonote.enforceTemplate",
        "title": "AlgoNote: Enforce Template"
      },
      {
        "command": "algonote.fillDetails",
        "title": "AlgoNote: Fill Details with AI"
      },
      {
        "command": "algonote.startQuiz",
        "title": "AlgoNote: Start MCQ Quiz",
        "icon": "$(beaker)"
      },
      {
        "command": "algonote.showRevisionTree",
        "title": "AlgoNote: Refresh Revision Sidebar"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "algonote-sidebar",
          "title": "AlgoNote Helper",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "algonote-sidebar": [
        {
          "id": "algonote-revision",
          "name": "Revision Dashboard",
          "type": "tree"
        },
        {
          "id": "algonote-quiz",
          "name": "Active Recall Quiz",
          "type": "webview"
        }
      ]
    },
    "chatParticipants": [
      {
        "id": "algonote.algo",
        "fullName": "AlgoNote",
        "name": "algo",
        "description": "AlgoNote assistant for linting, templates, and complexity analysis",
        "isSticky": true,
        "commands": [
          {
            "name": "lint",
            "description": "Lint the current DSA note for missing structures"
          },
          {
            "name": "mcq",
            "description": "Generate practice questions based on current note"
          },
          {
            "name": "dryrun",
            "description": "Generate a dry-run trace table for the code"
          },
          {
            "name": "complexity",
            "description": "Analyze time and space complexity"
          },
          {
            "name": "template",
            "description": "Insert boilerplate for a specific DSA topic"
          }
        ]
      }
    ],
    "configuration": {
      "title": "AlgoNote",
      "properties": {
        "algonote.aiProvider": {
          "type": "string",
          "default": "copilot",
          "enum": [
            "copilot",
            "gemini",
            "ollama",
            "custom"
          ],
          "enumDescriptions": [
            "GitHub Copilot (built-in, no API key needed)",
            "Google Gemini API (requires Gemini API Key)",
            "Local Ollama Server (e.g. http://localhost:11434)",
            "Custom OpenAI-compatible API (OpenRouter, DeepSeek, LocalAI, etc.)"
          ],
          "description": "Select AI Provider for generating note details and quiz questions."
        },
        "algonote.copilotModel": {
          "type": "string",
          "default": "gpt-4o",
          "enum": [
            "gpt-4o",
            "gpt-4o-mini",
            "claude-sonnet-4-5",
            "o3-mini"
          ],
          "description": "Copilot model family to use when Provider is set to 'copilot'."
        },
        "algonote.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Google Gemini API (Required if Provider is 'gemini')."
        },
        "algonote.geminiModel": {
          "type": "string",
          "default": "gemini-1.5-flash",
          "description": "Gemini model name (e.g. gemini-1.5-flash, gemini-1.5-pro)."
        },
        "algonote.ollamaUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Endpoint URL for local Ollama server (Required if Provider is 'ollama')."
        },
        "algonote.ollamaModel": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model name (e.g. llama3, mistral, qwen2.5-coder)."
        },
        "algonote.customEndpoint": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API endpoint URL (Required if Provider is 'custom')."
        },
        "algonote.customApiKey": {
          "type": "string",
          "default": "",
          "description": "API Key for Custom OpenAI-compatible API."
        },
        "algonote.customModel": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Model name for Custom API (e.g. gpt-4o, deepseek-chat, mistral-large)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm version patch --no-git-tag-version && npx @vscode/vsce package --no-dependencies --allow-missing-repository",
    "test": "npm run compile && node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.9",
    "glob": "^10.3.10",
    "mocha": "^10.3.0",
    "typescript": "^4.9.5"
  }
}
